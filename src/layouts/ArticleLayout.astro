---
interface Props {
  title: string;
  description: string;
  category: string;
  slug: string;
  /** 仕様を確認した日。比較記事では必須。 */
  verifiedAt?: string;
  /** comparison は購入導線を持つ比較記事。guide は導線なしの一般ガイド。 */
  type?: 'comparison' | 'guide';
}
const { title, description, category, slug, verifiedAt, type = 'guide' } = Astro.props;
const canonical = `https://erabi-note.jp/articles/${slug}/`;

// 構造化データ。検索結果での見え方を安定させるため、全記事に出力する。
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: title,
      description,
      articleSection: category,
      inLanguage: 'ja',
      mainEntityOfPage: canonical,
      ...(verifiedAt ? { dateModified: verifiedAt } : {}),
      publisher: { '@type': 'Organization', name: 'えらびノート', url: 'https://erabi-note.jp/' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'トップ', item: 'https://erabi-note.jp/' },
        { '@type': 'ListItem', position: 2, name: category },
        { '@type': 'ListItem', position: 3, name: title, item: canonical },
      ],
    },
  ],
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title}｜えらびノート</title>
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline></script>
  </head>
  <body>
    <div class="topline"></div>
    <header class="site-header">
      <div class="wrap nav">
        <a class="brand" href="/"><i></i>えらびノート</a>
        <nav class="nav-links" aria-label="主要メニュー">
          <a href="/">トップ</a>
          <a href="/#articles">比較ガイド</a>
          <a href="/policies/">運営・ポリシー</a>
        </nav>
      </div>
    </header>

    <main class="wrap article">
      <p class="category">{category}</p>
      <slot />

      {type === 'comparison' && (
        <p class="verified-note">
          {verifiedAt && <>仕様の確認日：{verifiedAt}。</>}
          仕様・容量・対応条件は各メーカー公式ページの表示を根拠にしています。価格・在庫・販売条件は変動するため比較の根拠にしていません。
        </p>
      )}

      {/* アフィリエイト開示。比較記事では記事内に必ず出す（プログラム規約の要件）。 */}
      {type === 'comparison' && (
        <aside class="disclosure">
          <strong>広告について：</strong>Amazonのアソシエイトとして、えらびノートは適格販売により収入を得ています。
          記事内の商品リンクから購入された場合、当サイトに紹介料が発生することがあります。
          紹介料の有無は比較結果や掲載順に影響していません。
        </aside>
      )}
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <div><a class="brand" href="/"><i></i>えらびノート</a><p>日用品の比較・選び方ガイド</p></div>
        <div><a href="/policies/">運営・ポリシー</a><p>© {new Date().getFullYear()} えらびノート</p></div>
      </div>
    </footer>
  </body>
</html>
<style is:global>
  :root {
    --ink: #14211e; --muted: #60706a; --paper: #fbfbf8; --line: #dde4df; --mist: #eef3ef;
    --mint: #a5e9ca; --mint-deep: #12694e; --lime: #d8f363; --orange: #ffb777; --blue: #9dc9ff;
    --radius: 22px;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--paper); color: var(--ink);
    font-family: "Noto Sans JP", sans-serif; line-height: 1.85;
  }
  a { color: var(--mint-deep); }
  .wrap { width: min(880px, calc(100% - 40px)); margin: auto; }
  .topline { height: 5px; background: linear-gradient(90deg, var(--mint-deep), var(--mint), var(--lime)); }

  .site-header {
    border-bottom: 1px solid var(--line); background: rgba(251, 251, 248, .94);
    backdrop-filter: blur(14px); position: sticky; top: 0; z-index: 10;
  }
  .site-header .wrap { width: min(1180px, calc(100% - 40px)); }
  .nav { height: 74px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .brand {
    font-family: "DM Sans", sans-serif; font-size: 22px; font-weight: 700;
    letter-spacing: -.05em; text-decoration: none; color: inherit;
  }
  .brand i { display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: var(--mint-deep); margin: 0 6px 2px 1px; }
  .nav-links { display: flex; align-items: center; gap: 23px; font-size: 14px; font-weight: 700; }
  .nav-links a { text-decoration: none; color: #40504a; }
  .nav-links a:hover { color: var(--mint-deep); }

  .article { padding: 52px 0 80px; }
  .category { color: var(--mint-deep); font: 700 12px/1 "DM Sans", sans-serif; letter-spacing: .14em; margin: 0 0 14px; }

  h1 { font-size: clamp(28px, 4.4vw, 44px); letter-spacing: -.05em; line-height: 1.3; margin: 0 0 24px; }
  h2 {
    font-size: clamp(21px, 2.8vw, 29px); letter-spacing: -.04em; line-height: 1.45;
    margin: 3.4rem 0 1.1rem; padding-bottom: .6rem; border-bottom: 2px solid var(--mint);
  }
  h3 { font-size: 18px; letter-spacing: -.02em; margin: 2.2rem 0 .6rem; }
  p { margin: 0 0 1.1rem; }
  ul, ol { padding-left: 1.3em; }
  li { margin-bottom: .5rem; }

  .lead { font-size: 17px; color: #33443e; }

  .notice {
    background: var(--mist); border-radius: 16px; padding: 20px 24px; margin: 0 0 1.6rem;
    font-size: 15px;
  }

  /* 比較表。列が多く本文幅では日本語が1〜2文字で折り返されるため、本文より広く使う。 */
  .score {
    width: min(1400px, calc(100vw - 48px));
    margin: 1.6rem 0 1.6rem 50%;
    transform: translateX(-50%);
    background: #fff; border: 1px solid var(--line); border-radius: 18px;
    padding: 6px; overflow-x: auto; -webkit-overflow-scrolling: touch;
  }
  /* 横スクロールできることが見て分かるようにスクロールバーを常時表示する。 */
  .score { scrollbar-color: #b9ccc2 #eef3f0; scrollbar-width: thin; }
  .score::-webkit-scrollbar { height: 10px; }
  .score::-webkit-scrollbar-track { background: #eef3f0; border-radius: 999px; }
  .score::-webkit-scrollbar-thumb { background: #b9ccc2; border-radius: 999px; }
  .score::-webkit-scrollbar-thumb:hover { background: #9bb3a6; }

  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  /* 日本語の説明文が1〜2文字で折り返されないよう、列に最低幅を持たせる。 */
  th, td {
    border-bottom: 1px solid var(--line); padding: 13px 14px;
    text-align: left; vertical-align: top; min-width: 165px;
  }
  /* メーカー名と購入ボタンは短いので、幅を説明列に回す。 */
  thead th:nth-child(2), tbody td:nth-child(2) { min-width: 96px; }
  thead th:last-child, tbody td:last-child { min-width: 104px; }
  thead th { background: var(--mist); font-weight: 700; white-space: nowrap; border-bottom: 2px solid var(--mint); }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }
  tbody th { width: 30%; background: #fafcfa; font-weight: 600; }

  /* 製品名の列は横スクロール中も残す。どの製品の行かを見失わないようにする。 */
  .score table thead th:first-child,
  .score table tbody td:first-child {
    position: sticky; left: 0; z-index: 1;
    min-width: 210px; box-shadow: 1px 0 0 var(--line);
  }
  .score table tbody td:first-child { background: #fff; }
  .score table thead th:first-child { background: var(--mist); }

  /* 比較表内の製品セル（画像＋製品名）。 */
  .cell-product { display: flex; align-items: flex-start; gap: 11px; }
  .cell-product img {
    flex: none; width: 56px; height: 56px; object-fit: contain;
    background: #fafcfa; border-radius: 8px;
  }

  .source {
    font-size: 13px; color: var(--muted); background: #fff; border: 1px solid var(--line);
    border-radius: 14px; padding: 15px 20px; margin: 1rem 0 0;
  }
  ul.source { padding: 15px 20px 15px 2.2em; }
  ul.source li { margin-bottom: .35rem; }

  /* 製品カード。画像・仕様・購入導線を1ブロックにまとめる。 */
  .products { display: grid; gap: 14px; margin: 1.4rem 0; }
  .product {
    display: grid; grid-template-columns: 132px 1fr auto; gap: 20px; align-items: center;
    background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 18px 20px;
  }
  .product img { width: 132px; height: 132px; object-fit: contain; display: block; }
  .product .brand-name { font: 700 11px "DM Sans", sans-serif; letter-spacing: .1em; color: var(--muted); }
  .product h3 { margin: 4px 0 6px; font-size: 17px; }
  .product p { margin: 0; font-size: 14px; color: #3d4d47; }

  .buy {
    display: inline-flex; align-items: center; gap: 8px; white-space: nowrap;
    background: var(--ink); color: #fff; border-radius: 999px; padding: 12px 20px;
    text-decoration: none; font-size: 14px; font-weight: 700;
  }
  .buy:hover { background: var(--mint-deep); }
  .buy::after { content: "↗"; font-size: 15px; line-height: 0; }
  td .buy { padding: 8px 14px; font-size: 13px; }

  /* Amazon・楽天を併記するときのボタン群。楽天は赤系にして誤クリックしないよう見分けをつける。 */
  .buy-group { display: inline-flex; flex-direction: column; gap: 7px; }
  .buy.rakuten { background: #bf0000; }
  .buy.rakuten:hover { background: #8f0000; }
  td .buy-group { gap: 5px; }

  /* 一緒に見ておきたい消耗品。比較対象より軽く見せる。 */
  .related { display: grid; gap: 10px; margin: 1.2rem 0; }
  .related-item {
    display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    background: #fff; border: 1px dashed #c6d5cc; border-radius: 14px; padding: 14px 18px;
  }
  .related-item div { flex: 1 1 260px; }
  .related-item strong { display: block; font-size: 15px; }
  .related-item span { font-size: 13px; color: var(--muted); }

  .verified-note {
    margin-top: 2.6rem; padding-top: 1.2rem; border-top: 1px solid var(--line);
    font-size: 13px; color: var(--muted);
  }

  .disclosure {
    margin-top: 1rem; background: var(--mist); border-radius: 14px; padding: 16px 20px;
    font-size: 13px; color: #40504a;
  }

  .footer { background: var(--ink); color: #d7e3db; padding: 43px 0 32px; margin-top: 40px; }
  .footer .wrap { width: min(1180px, calc(100% - 40px)); }
  .footer-inner { display: flex; justify-content: space-between; gap: 20px; align-items: flex-start; }
  .footer .brand { color: #fff; }
  .footer p { font-size: 12px; color: #9baca3; margin: 10px 0 0; }
  .footer a { font-size: 13px; color: #d7e3db; }

  @media (max-width: 700px) {
    .nav { height: auto; min-height: 68px; padding: 12px 0; align-items: flex-start; flex-direction: column; gap: 10px; }
    .nav-links { gap: 14px; font-size: 12px; }
    .article { padding: 32px 0 56px; }
    h2 { margin-top: 2.6rem; }
    /* 画面が狭いときは本文と同じ幅に戻し、横スクロールで読ませる。 */
    .score { width: 100%; margin-left: 0; transform: none; }
    th, td { min-width: 150px; padding: 11px 12px; font-size: 13px; }
    thead th:nth-child(2), tbody td:nth-child(2) { min-width: 84px; }
    thead th:last-child, tbody td:last-child { min-width: 96px; }
    /* 固定列が画面の半分を占めると中身が読めないため、幅を詰めて画像は省く。
       商品画像は下の製品カードにも出るので、表から消えても情報は失われない。 */
    .score table thead th:first-child,
    .score table tbody td:first-child { min-width: 132px; }
    .cell-product img { display: none; }
    .product { grid-template-columns: 92px 1fr; gap: 14px; padding: 15px 16px; }
    .product img { width: 92px; height: 92px; }
    .product .buy-group, .product .buy { grid-column: 1 / -1; }
    .product .buy { justify-content: center; }
    .product .buy-group { align-items: center; }
    .footer-inner { flex-direction: column; }
  }
</style>
