---
interface Props {
  title: string;
  description: string;
  category: string;
  slug: string;
}
const { title, description, category, slug } = Astro.props;
const canonical = `https://erabi-note.jp/articles/${slug}/`;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title}｜えらびノート</title>
  </head>
  <body>
    <header><div class="wrap bar"><a class="brand" href="/">えらびノート</a><nav aria-label="主要メニュー"><a href="/">トップ</a><a href="/policies/">運営・ポリシー</a></nav></div></header>
    <main class="wrap"><p class="category">{category}</p><slot /></main>
    <footer><div class="wrap"><a href="/policies/">運営・ポリシー</a><p>© {new Date().getFullYear()} えらびノート</p></div></footer>
  </body>
</html>
<style>
  :global(*) { box-sizing: border-box; } :global(body) { margin:0; color:#19324a; background:#f7fafc; font-family:-apple-system,BlinkMacSystemFont,"Hiragino Kaku Gothic ProN","Noto Sans JP",sans-serif; line-height:1.85; } .wrap { width:min(920px,calc(100% - 40px)); margin:auto; } header { background:#fff; border-bottom:1px solid #dbe6ed; } .bar { min-height:72px; display:flex; align-items:center; justify-content:space-between; gap:20px; } .brand { color:#154f72; font-weight:800; text-decoration:none; font-size:1.2rem; } nav { display:flex; gap:18px; flex-wrap:wrap; } a { color:#176b93; } nav a { font-size:.92rem; } main { padding:58px 0 72px; } .category { color:#16806d; font-size:.82rem; font-weight:800; letter-spacing:.08em; } :global(h1) { font-size:clamp(1.8rem,4vw,2.65rem); line-height:1.35; color:#123d59; margin:.25rem 0 1.4rem; } :global(h2) { color:#124f6d; margin:3rem 0 1rem; padding-left:.8rem; border-left:5px solid #49a885; line-height:1.5; } :global(h3) { color:#174e69; margin-top:1.7rem; } :global(.lead) { font-size:1.12rem; } :global(.notice) { background:#e9f5f1; border-radius:12px; padding:18px 22px; } :global(.score) { background:#fff; border:1px solid #d7e4ea; border-radius:14px; padding:20px 24px; } :global(table) { width:100%; border-collapse:collapse; background:#fff; } :global(th),:global(td) { border:1px solid #d7e4ea; padding:12px; text-align:left; vertical-align:top; } :global(th) { width:31%; background:#eef7f5; } :global(.source) { font-size:.92rem; background:#fff; padding:15px 20px; border-radius:10px; } :global(.disclosure) { margin-top:36px; color:#526b7e; font-size:.9rem; } footer { border-top:1px solid #dbe6ed; background:#fff; padding:25px 0; font-size:.88rem; color:#577084; } footer p { margin:.5rem 0 0; } @media(max-width:620px){.bar{padding:14px 0;align-items:flex-start;flex-direction:column;gap:8px}main{padding-top:36px}:global(th){width:38%}}
</style>
